// Type-checks test sources, which `tsconfig.json` excludes entirely.
//
// Every suite is checked. Fix a type error at its source; never add a suite to
// `exclude`, which holds only build output and the DOM-lib viewer suites.
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    // Suites that import a `.mjs` operator script get its types inferred from
    // that file's own JSDoc, rather than from a separate `.d.mts` that nothing
    // holds to the implementation. The script bodies stay unchecked (no
    // `checkJs`), so an unannotated export still resolves to `any`.
    "allowJs": true,
    "rootDir": ".",
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false
  },
  "include": [
    "tests/**/*.ts",
    "tests/**/*.tsx",
    "src/**/*.d.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "tests/**/*.test.js",
    "tests/**/*.spec.js",
    // Covered by `tsconfig.viewer-tests.json`, which carries the DOM lib.
    "tests/viewer"
  ]
}
