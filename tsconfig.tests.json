// Type-checks test sources, which `tsconfig.json` excludes entirely.
//
// `exclude` is a staged backlog, not a suppression: every entry is a suite that
// does not type-check yet on `main`. Delete an entry once its errors are fixed
// at the source -- the list only ever shrinks, and new test files are checked
// by default because `include` is a glob.
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    // Suites that import a `.mjs` operator script get its types inferred from
    // that file's own JSDoc, rather than from a separate `.d.mts` that nothing
    // holds to the implementation. The script bodies stay unchecked (no
    // `checkJs`), so an unannotated export still resolves to `any`.
    "allowJs": true,
    "rootDir": ".",
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false
  },
  "include": [
    "tests/**/*.ts",
    "tests/**/*.tsx",
    "src/**/*.d.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "tests/**/*.test.js",
    "tests/**/*.spec.js",
    // Covered by `tsconfig.viewer-tests.json`, which carries the DOM lib.
    "tests/viewer",
    "tests/bun-runner.test.ts",
    "tests/cli/handlers/session-init-plugin-cache-skip.test.ts",
    "tests/cli/worker-failure-latch.test.ts",
    "tests/hook-lifecycle.test.ts",
    "tests/hooks/server-client.test.ts",
    "tests/infrastructure/cleanup-v12_4_3.test.ts",
    "tests/install-error-matrix.test.ts",
    "tests/integrations/telegram-wrapup-notifier.test.ts",
    "tests/plugin-version-check.test.ts",
    "tests/sdk/hardened-options-thinking.test.ts",
    "tests/security/observer-tool-enforcement.test.ts",
    // The fakes cannot satisfy `Pick<Worker, 'on'>`, whose `on` must return a
    // real Worker. Needs the ServerJobQueue test seam narrowed to what the
    // class calls, which BullMQ's unresolved generics block -- tracked in MCAA-432.
    "tests/server/jobs/server-job-queue.test.ts",
    "tests/server/mcp/recall-mcp-server.test.ts",
    "tests/server/middleware/request-id.test.ts",
    "tests/server/runtime/active-queue-manager.test.ts",
    "tests/services/sync/chroma-mcp-manager-singleton.test.ts",
    "tests/services/sync/chroma-sync-reconcile.test.ts",
    "tests/services/sync/chroma-sync-watermarks.test.ts",
    "tests/shared/kill-process-tree-identity.test.ts",
    "tests/shared/oauth-token.test.ts",
    "tests/shared/observed-billing.test.ts",
    "tests/shared/settings-defaults-manager.test.ts",
    "tests/sqlite/session-store-synced-at.test.ts",
    "tests/storage/postgres/platform-source-scoping.test.ts",
    "tests/telemetry/skill-id.test.ts",
    "tests/worker/http/routes/cloud-sync-routes.test.ts",
    "tests/worker/search/search-orchestrator.test.ts",
    "tests/worker/session-manager-project.test.ts",
    "tests/worker/session-manager-wrapup.test.ts",
    "tests/worker/sync/cloud-sync.test.ts"
  ]
}
